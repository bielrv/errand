{
  "name": "errand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A generic voice agent that phones companies on your behalf and works a task to completion.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "task": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "prompt": "tsx scripts/show-prompt.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "twilio": "^5.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

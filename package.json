{
  "name": "errand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A generic voice agent that phones companies on your behalf and works a task to completion.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "task": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "prompt": "tsx scripts/show-prompt.ts",
    "worker": "tsx src/agent/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@livekit/agents": "^1.9.1",
    "@livekit/agents-plugin-anthropic": "^1.9.1",
    "@livekit/agents-plugin-deepgram": "^1.9.1",
    "@livekit/agents-plugin-elevenlabs": "^1.9.1",
    "@livekit/agents-plugin-livekit": "^1.9.1",
    "@livekit/agents-plugin-silero": "^1.9.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "livekit-server-sdk": "^2.19.1",
    "twilio": "^5.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

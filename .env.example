# --- which voice stack ---------------------------------------------------------
# vapi    = managed. They own the media path and call our webhooks. Start here.
# livekit = we own the pipeline. Needs the worker process running too.
VOICE_STACK=vapi

# --- where this server is reachable from the internet -------------------------
# Dev: run `npx untun@latest tunnel http://localhost:3000` or use ngrok/cloudflared
PUBLIC_URL=https://your-tunnel.example.com
PORT=3000
# any long random string; providers must echo it back
WEBHOOK_SECRET=change-me-to-something-long

# --- the brain and the voice (both stacks) ------------------------------------
MODEL_PROVIDER=anthropic
MODEL=claude-opus-5
VOICE_PROVIDER=11labs
VOICE_ID=burt
TRANSCRIBER_PROVIDER=deepgram
TRANSCRIBER_MODEL=nova-3
# Call centre agents pause mid-sentence. Longer than a video-call default.
END_OF_TURN_SILENCE_MS=900

# --- VOICE_STACK=vapi ---------------------------------------------------------
VAPI_API_KEY=
# id of the Twilio number you imported into Vapi (Dashboard > Phone Numbers)
VAPI_PHONE_NUMBER_ID=

# --- VOICE_STACK=livekit ------------------------------------------------------
# LiveKit Cloud project, or your own server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound SIP trunk id (ST_...), created once from your Twilio elastic SIP trunk
LIVEKIT_SIP_TRUNK_ID=
# Caller ID. Leave empty to use the trunk's own number.
LIVEKIT_SIP_FROM_NUMBER=
# Must match the worker's agentName. Leave as-is unless you run several workers.
LIVEKIT_AGENT_NAME=errand
RINGING_TIMEOUT_SECONDS=60
# The livekit stack needs these provider keys directly, since we call them
# rather than Vapi doing it for us:
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=

# --- Twilio (the number itself, plus SMS escalation) --------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+44...

# --- you ----------------------------------------------------------------------
PRINCIPAL_NAME=Gabriel Rosinol
PRINCIPAL_MOBILE=+44...
AGENT_NAME=Max
PRINCIPAL_WAIT_SECONDS=45
MAX_CALL_SECONDS=2700

TICK_MS=30000
DB_PATH=./data/errand.db
